===== data/cobble_26_smoke/function/admin_probe.mcfunction =====
$transfer example.org 25565 $(player)
$swing $(player) mainhand
return run say nested return ok
test run minecraft:always_pass 1 true

===== data/cobble_26_smoke/function/announce.mcfunction =====
$tellraw @a {"text":"$(message)","color":"aqua"}

===== data/cobble_26_smoke/function/init.mcfunction =====
gamerule max_command_sequence_length 1000000000
scoreboard objectives add temp dummy
scoreboard players set score temp 10
scoreboard players set health temp 20
scoreboard players set active temp 1
data modify storage cobble_26_smoke:global args.message set value "Cobble 26.1.2 smoke test loaded"
function cobble_26_smoke:announce with storage cobble_26_smoke:global args
data modify storage cobble_26_smoke:global args.player set value "@a"
data modify storage cobble_26_smoke:global args.amount set value 1
function cobble_26_smoke:reward with storage cobble_26_smoke:global args
scoreboard objectives add smoke dummy "Smoke Test"
tellraw @a {"text":"Smoke datapack initialized","color":"green"}
dialog clear @a
dialog show @a cobble_26_smoke:notice
fetchprofile name Notch
fetchprofile id 123e4567-e89b-12d3-a456-426614174000
waypoint list
stopwatch create cobble:smoke
stopwatch query cobble:smoke 20.0
version

===== data/cobble_26_smoke/function/operator_probe.mcfunction =====
execute as @a[tag=operator] run tellraw @s {"text":"Operator probe","color":"yellow"}

===== data/cobble_26_smoke/function/reward.mcfunction =====
$give $(player) minecraft:diamond $(amount)
$say rewarded $(player) with $(amount) diamond

===== data/cobble_26_smoke/function/survivor_ping.mcfunction =====
execute as @a[gamemode=survival] run say survivor online

===== data/cobble_26_smoke/function/tick.mcfunction =====
scoreboard players add score temp 1
scoreboard players set if_branch_0 temp 0
execute if score score temp matches 15.. run scoreboard players set if_branch_0 temp 1
execute if score score temp matches 15.. run tellraw @a [{"text":"score high "},{"score":{"name":"score","objective":"temp"}}]
scoreboard players set elif_taken_1 temp 0
execute unless score if_branch_0 temp matches 1 if score score temp matches 12.. run scoreboard players set elif_taken_1 temp 1
execute if score elif_taken_1 temp matches 1 run scoreboard players set if_branch_0 temp 1
execute if score elif_taken_1 temp matches 1 run tellraw @a [{"text":"score medium "},{"score":{"name":"score","objective":"temp"}}]
execute unless score if_branch_0 temp matches 1 run tellraw @a [{"text":"score low "},{"score":{"name":"score","objective":"temp"}}]
scoreboard players operation match_temp_2 temp = score temp
execute if score match_temp_2 temp matches 0..14 run say warming
execute if score match_temp_2 temp matches 15..30 run say active
execute unless score match_temp_2 temp matches 0..14 unless score match_temp_2 temp matches 15..30 run say overflow
say loop 0
say loop 1
say loop 2
execute as @a[gamemode=creative] at @s run particle flame ~ ~1 ~

