===== data/cobble_stdlib_v3/function/load.mcfunction =====
gamerule max_command_sequence_length 1000000000
data modify storage cobble_stdlib_v3:global players.current set value "alex"
data modify storage cobble_stdlib_v3:global players.current.score set value 10
data get storage cobble_stdlib_v3:global players.events[0]
tellraw @a {"color":"gold","text":"Stdlib v3 helpers ready"}
tp @s ~ ~1 ~
schedule function cobble_stdlib_v3:load 20t replace
schedule clear cobble_stdlib_v3:load

