===== data/cobble_26_feature_matrix/function/admin_audit.mcfunction =====
$tag $(player) add matrix_admin
$effect give $(player) minecraft:glowing 5 0 true
$playsound minecraft:block.note_block.pling master $(player) ~ ~ ~ 1 1
schedule function cobble_26_feature_matrix:tick 20t replace
return run say audit complete

===== data/cobble_26_feature_matrix/function/announce.mcfunction =====
$tellraw @a {"text":"$(message)","color":"light_purple"}

===== data/cobble_26_feature_matrix/function/give_kit.mcfunction =====
$give $(player) minecraft:$(item) $(count)
$title $(player) actionbar {"text":"Kit count: $(count)"}

===== data/cobble_26_feature_matrix/function/load.mcfunction =====
gamerule max_command_sequence_length 1000000000
scoreboard objectives add math dummy
scoreboard objectives add temp dummy
scoreboard players set score temp 7
scoreboard players set energy temp 5
scoreboard players set stage temp 0
scoreboard players set enabled temp 1
data modify storage cobble_26_feature_matrix:global vars.status set value "boot"
function cobble_26_feature_matrix:setup_scoreboards
data modify storage cobble_26_feature_matrix:global args.message set value "Feature matrix online"
function cobble_26_feature_matrix:announce with storage cobble_26_feature_matrix:global args
data modify storage cobble_26_feature_matrix:global args.player set value "@a"
data modify storage cobble_26_feature_matrix:global args.item set value "diamond"
data modify storage cobble_26_feature_matrix:global args.count set value 2
function cobble_26_feature_matrix:give_kit with storage cobble_26_feature_matrix:global args
tellraw @a {"bold":true,"color":"aqua","text":"Feature matrix loaded"}
title @a title {"text":"Matrix score"}
scoreboard players set matrix_ready temp 1
execute store result score matrix_roll temp run random value 1..6
scoreboard players set matrix_timer temp 20
data modify storage cobble_26_feature_matrix:global status set value {state:"loaded",enabled:1b}
data modify storage cobble_26_feature_matrix:global events append value "loaded"
execute store result score matrix_state_count temp run data get storage cobble_26_feature_matrix:global events 1
schedule function cobble_26_feature_matrix:tick 20t replace
tag @a add matrix_loader
scoreboard players set #math_input math 100
function cobble_26_feature_matrix:_cobble_math_sqrt
scoreboard players operation root temp = #math_result math
datapack list enabled
random roll 1..6
dialog clear @a
waypoint list
stopwatch create cobble:matrix
stopwatch query cobble:matrix 20.0
version

===== data/cobble_26_feature_matrix/function/marker_scan.mcfunction =====
execute as @e[type=armor_stand,tag=matrix_marker,distance=..16] run data merge entity @s {Glowing:1b}
execute as @a[tag=admin] run tellraw @s {"text":"Marker scan complete","color":"green"}

===== data/cobble_26_feature_matrix/function/match_case_0_4.mcfunction =====
scoreboard players set stage temp 1
say stage zero

===== data/cobble_26_feature_matrix/function/match_case_1_5.mcfunction =====
scoreboard players set stage temp 2
say stage middle

===== data/cobble_26_feature_matrix/function/match_default_6.mcfunction =====
scoreboard players set stage temp 4
say stage fallback

===== data/cobble_26_feature_matrix/function/setup_scoreboards.mcfunction =====
scoreboard objectives add matrix dummy {"text":"Matrix"}
scoreboard objectives add matrix_energy dummy {"text":"Energy"}
scoreboard objectives setdisplay sidebar matrix
team add matrix {"text":"Matrix"}
team modify matrix color aqua
bossbar add cobble_26_feature_matrix:matrix {"text":"Feature Matrix"}
bossbar set cobble_26_feature_matrix:matrix max 100
bossbar set cobble_26_feature_matrix:matrix value 25
bossbar set cobble_26_feature_matrix:matrix color blue
bossbar set cobble_26_feature_matrix:matrix players @a

===== data/cobble_26_feature_matrix/function/tick.mcfunction =====
scoreboard players add score temp 3
scoreboard players operation doubled temp = score temp
scoreboard players set #multiplier temp 2
scoreboard players operation doubled temp *= #multiplier temp
scoreboard players operation combined temp = doubled temp
scoreboard players add combined temp 5
scoreboard players operation remainder temp = combined temp
scoreboard players set #modulus temp 4
scoreboard players operation remainder temp %= #modulus temp
scoreboard players set power temp 27
data modify storage cobble_26_feature_matrix:global vars.status set value "running"
execute if score matrix_timer temp matches 1.. run scoreboard players remove matrix_timer temp 1
scoreboard players set matrix_timer_done temp 0
execute if score matrix_timer temp matches ..0 run scoreboard players set matrix_timer_done temp 1
scoreboard players set if_branch_0 temp 0
execute if score score temp matches 21.. unless score energy temp matches 0 run scoreboard players set if_branch_0 temp 1
execute if score score temp matches 21.. unless score energy temp matches 0 run tellraw @a[gamemode=!spectator] {"text":"High score ","color":"gold"}
scoreboard players set or_temp_1 temp 0
execute if score score temp matches 10 run scoreboard players set or_temp_1 temp 1
execute if score energy temp matches 0 run scoreboard players set or_temp_1 temp 1
scoreboard players set elif_taken_2 temp 0
execute unless score if_branch_0 temp matches 1 if score or_temp_1 temp matches 1 run scoreboard players set elif_taken_2 temp 1
execute if score elif_taken_2 temp matches 1 run scoreboard players set if_branch_0 temp 1
execute if score elif_taken_2 temp matches 1 run tellraw @a[gamemode=!spectator] {"text":"Threshold reached","color":"yellow"}
execute unless score if_branch_0 temp matches 1 run tellraw @a[gamemode=!spectator] {"text":"Matrix warming","color":"gray"}
scoreboard players operation match_temp_3 temp = remainder temp
execute if score match_temp_3 temp matches 0 run function cobble_26_feature_matrix:match_case_0_4
execute if score match_temp_3 temp matches 1..2 run function cobble_26_feature_matrix:match_case_1_5
execute unless score match_temp_3 temp matches 0..0 unless score match_temp_3 temp matches 1..2 run function cobble_26_feature_matrix:match_default_6
function cobble_26_feature_matrix:while_temp_7
tellraw @a {"text":"even loop 0","color":"green"}
tellraw @a {"text":"even loop 2","color":"green"}
tellraw @a {"text":"even loop 4","color":"green"}
say reverse loop 7
say reverse loop 4
say reverse loop 1
execute as @a[gamemode=!spectator] at @s if entity @s[distance=..32] run particle minecraft:happy_villager ~ ~1 ~ 0.25 0.25 0.25 0 3
execute positioned ~ ~2 ~ rotated ~ 0 run particle minecraft:flame ~ ~ ~ 0 0 0 0 1
tellraw @a [{"color":"blue","text":"Status: "},{"nbt":"vars.status","storage":"cobble_26_feature_matrix:global"}]

===== data/cobble_26_feature_matrix/function/while_body_8.mcfunction =====
tellraw @a [{"text":"draining "},{"score":{"name":"energy","objective":"temp"}}]
scoreboard players remove energy temp 1

===== data/cobble_26_feature_matrix/function/while_temp_7.mcfunction =====
execute if score energy temp matches 1.. run function cobble_26_feature_matrix:while_body_8
execute if score energy temp matches 1.. run function cobble_26_feature_matrix:while_temp_7

