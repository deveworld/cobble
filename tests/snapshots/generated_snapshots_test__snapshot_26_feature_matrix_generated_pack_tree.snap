function cobble_26_feature_matrix:_cobble_text_entry_0 with storage cobble_26_feature_matrix:global args
data remove storage cobble_26_feature_matrix:global _call_args_2
tellraw @a {"bold":true,"color":"aqua","text":"Feature matrix loaded"}
title @a title {"text":"Matrix score"}
scoreboard players set matrix_ready cobble_26_feature_matrix.vars 1
execute store result score matrix_roll cobble_26_feature_matrix.vars run random value 1..6
scoreboard players set matrix_timer cobble_26_feature_matrix.vars 20
data modify storage cobble_26_feature_matrix:global status set value {state:"loaded",enabled:1b}
data modify storage cobble_26_feature_matrix:global events append value "loaded"
execute store result score matrix_state_count cobble_26_feature_matrix.vars run data get storage cobble_26_feature_matrix:global events 1
schedule function cobble_26_feature_matrix:tick 20t replace
tag @a add matrix_loader
data modify storage cobble_26_feature_matrix:global locals.load._cobble_number_3 set value 100
data modify storage cobble_26_feature_matrix:global _cobble_numeric.left set from storage cobble_26_feature_matrix:global locals.load._cobble_number_3
data modify storage cobble_26_feature_matrix:global _cobble_numeric.right set value 0
