{
  "name": "cobble-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:wasm && next dev --webpack",
    "build:wasm": "rm -rf src/wasm/pkg public/wasm && wasm-pack build wasm --target web --out-dir ../src/wasm/pkg --release && mkdir -p public/wasm && cp src/wasm/pkg/cobble_web_wasm_bg.wasm public/wasm/cobble_web_wasm_bg.wasm",
    "build": "npm run build:wasm && next build --webpack",
    "build:github": "NEXT_PUBLIC_BASE_PATH=/cobble npm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "wasm-pack": "^0.15.0"
  }
}
